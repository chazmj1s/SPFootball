<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SaturdayPulse.AdminBlazor</RootNamespace>
    <UserSecretsId>23f64e88-269e-4a36-82ba-2ac258930dab</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin to a known-good version; feel free to let NuGet update this to whatever
         the current latest 7.x/8.x release is when you restore. -->
    <PackageReference Include="MudBlazor" Version="7.15.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared Content contracts (ApplicationContentDocument/ContentSection) -
         same source of truth Api and Mobile use. Assumes SaturdayPulse.Core
         sits as a sibling folder next to this project. -->
    <ProjectReference Include="..\SaturdayPulse.Core\SaturdayPulse.Core.csproj" />
  </ItemGroup>

</Project>
