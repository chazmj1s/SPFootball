@page "/metrics-rebuild"

<style>
    .mr-page { display: flex; flex-direction: column; height: calc(100vh - 64px); padding: 12px 16px; box-sizing: border-box; }
    .mr-title { font-size: 1.4rem; font-weight: 600; margin: 0 0 8px 0; }
    .mr-body { display: flex; gap: 16px; flex: 1; min-height: 0; }
    .mr-main { flex: 1; overflow: hidden; display: flex; flex-direction: column; }
    .mr-run-row { display: flex; align-items: center; gap: 8px; padding-bottom: 8px; margin-bottom: 6px; border-bottom: 1px solid var(--mud-palette-lines-default); }
    .mr-small-btn { font-size: 0.78rem !important; padding: 2px 10px !important; min-width: 0 !important; height: 26px; line-height: 1; }
    .mr-estimate { font-size: 0.8rem; opacity: 0.7; margin-right: auto; margin-left: 12px; }
    .mr-tier { margin-bottom: 4px; }
    .mr-tier-header { display: flex; align-items: center; gap: 6px; padding: 4px 2px; cursor: pointer; user-select: none; font-weight: 600; font-size: 0.9rem; }
    .mr-tier-header .mr-chevron { font-size: 1rem; width: 16px; }
    .mr-tier-count { font-size: 0.72rem; opacity: 0.6; font-weight: 400; }
    .mr-op-list { padding-left: 22px; }
    .mr-op-row { display: flex; align-items: center; gap: 8px; padding: 2px 0; font-size: 0.85rem; }
    .mr-op-label { min-width: 230px; }
    .mr-op-row select { font-size: 0.8rem; padding: 1px 4px; background: var(--mud-palette-background); color: inherit; border: 1px solid var(--mud-palette-lines-default); border-radius: 3px; }
    .mr-dryrun { display: flex; align-items: center; gap: 3px; font-size: 0.75rem; opacity: 0.85; }
    .mr-estimate-cell { margin-left: auto; font-size: 0.75rem; opacity: 0.55; white-space: nowrap; }
    .mr-checkbox { width: 15px; height: 15px; margin: 0; cursor: pointer; }
    .mr-divider { border: none; border-top: 1px solid var(--mud-palette-lines-default); margin: 6px 0; }

    .mr-log-col { width: 340px; flex-shrink: 0; display: flex; flex-direction: column; min-height: 0; }
    .mr-log-header { display: flex; align-items: center; justify-content: space-between; font-weight: 600; font-size: 0.9rem; padding-bottom: 4px; }
    .mr-log-panel { flex: 1; overflow-y: auto; background: var(--mud-palette-background-grey); border-radius: 4px; padding: 8px; font-family: 'Cascadia Code', 'Consolas', monospace; font-size: 0.76rem; line-height: 1.5; }
    .mr-log-empty { opacity: 0.5; }
    .mr-log-time { opacity: 0.5; margin-right: 6px; }
    .mr-log-success { color: var(--mud-palette-success); }
    .mr-log-error { color: var(--mud-palette-error); }
    .mr-log-running { color: var(--mud-palette-info); }
</style>

<div class="mr-page">
    <div style="display:flex; align-items:center; justify-content:space-between;">
        <h1 class="mr-title">Metrics Rebuild</h1>
    </div>

    <div class="mr-body">
        <div class="mr-main">
            <div class="mr-run-row">
                <MudButton Class="mr-small-btn" Variant="Variant.Outlined" OnClick="SelectAll" Disabled="Running">Select All</MudButton>
                <MudButton Class="mr-small-btn" Variant="Variant.Outlined" OnClick="ClearAll" Disabled="Running">Clear</MudButton>
                <span class="mr-estimate">@(EstimateLabel != "" ? $"Est. {EstimateLabel}" : "")</span>
                <MudButton Class="mr-small-btn" Variant="Variant.Filled" Color="Color.Error"
                           OnClick="RunSelectedAsync"
                           Disabled="@(Running || SelectedOps.Count == 0)">
                    @(Running ? "Running..." : $"Run Selected ({SelectedOps.Count})")
                </MudButton>
            </div>

            <div style="overflow-y:auto; flex:1;">
                @foreach (var tier in Tiers)
                {
                    <div class="mr-tier">
                        <div class="mr-tier-header" @onclick="() => ToggleTier(tier)">
                            <span class="mr-chevron">@(tier.Collapsed ? "▶" : "▼")</span>
                            <input type="checkbox" class="mr-checkbox"
                                   checked="@IsTierChecked(tier)"
                                   @onchange="e => OnTierToggle(tier, (bool)e.Value!)"
                                   @onclick:stopPropagation="true"
                                   disabled="@Running" />
                            <span>@tier.Label</span>
                            <select @onclick:stopPropagation="true" disabled="@Running"
                                    value="@(tier.TierYear?.ToString() ?? "")"
                                    @onchange="e => OnTierYearChanged(tier, string.IsNullOrEmpty(e.Value?.ToString()) ? null : int.Parse(e.Value.ToString()!))">
                                <option value="">Year</option>
                                @foreach (var yr in Years)
                                {
                                    <option value="@yr">@yr</option>
                                }
                            </select>
                            @if (TierSelectedCount(tier) > 0)
                            {
                                <span class="mr-tier-count">(@TierSelectedCount(tier) selected)</span>
                            }
                        </div>

                        @if (!tier.Collapsed)
                        {
                            <div class="mr-op-list">
                                @foreach (var op in tier.Ops)
                                {
                                    <div class="mr-op-row">
                                        <input type="checkbox" class="mr-checkbox" @bind="op.Selected" disabled="@Running" />
                                        <span class="mr-op-label">@op.Label</span>

                                        @if (op.RequiresYear)
                                        {
                                            <select disabled="@Running"
                                                    value="@op.Year"
                                                    @onchange="e => OnChildYearChanged(tier, op, int.Parse(e.Value!.ToString()!))">
                                                @foreach (var yr in Years)
                                                {
                                                    <option value="@yr">@yr</option>
                                                }
                                            </select>
                                        }

                                        @if (op.HasDryRun)
                                        {
                                            <label class="mr-dryrun">
                                                <input type="checkbox" class="mr-checkbox" @bind="op.DryRun" disabled="@Running" />
                                                Dry run
                                            </label>
                                        }

                                        <span class="mr-estimate-cell">~@op.EstimateLabel</span>
                                    </div>
                                }
                            </div>
                        }
                        <hr class="mr-divider" />
                    </div>
                }
            </div>
        </div>

        <div class="mr-log-col">
            <div class="mr-log-header">
                <span>Activity Log</span>
                @if (Log.Count > 0 && !Running)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" OnClick="ClearLog" />
                }
            </div>
            @if (Running)
            {
                <MudProgressLinear Indeterminate="true" Class="mb-1" Style="height:3px;" />
            }
            <div class="mr-log-panel">
                @if (Log.Count == 0)
                {
                    <span class="mr-log-empty">No activity yet.</span>
                }
                @foreach (var entry in Log)
                {
                    <div class="@LogCss(entry.Status)">
                        <span class="mr-log-time">@entry.Time</span>@entry.Message
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private static string LogCss(LogStatus status) => status switch
    {
        LogStatus.Success => "mr-log-success",
        LogStatus.Error   => "mr-log-error",
        LogStatus.Running => "mr-log-running",
        _                 => ""
    };
}
