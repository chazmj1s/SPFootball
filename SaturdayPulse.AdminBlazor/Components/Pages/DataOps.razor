@page "/data-ops"
@inject AdminApiService Api
@inject ISnackbar Snackbar
@using SaturdayPulse.AdminBlazor.Services.Models

<MudText Typo="Typo.h5" Class="mb-2">Data Operations</MudText>

<div class="page-layout">
    <div class="sections">

        <!-- ── Weekly Operations ───────────────────────────────── -->
        <MudText Typo="Typo.overline" Color="Color.Secondary">Weekly Operations</MudText>
        <div class="section-row">
            <MudNumericField @bind-Value="_weeklyYear" Label="Year" Variant="Variant.Outlined" Margin="Margin.Dense"
                             Disabled="IsBusy" Class="param-field" />
            <MudNumericField @bind-Value="_weeklyWeek" Label="Week" Variant="Variant.Outlined" Margin="Margin.Dense"
                             Disabled="IsBusy" Class="param-field narrow" />
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="IsBusy" OnClick="RunWeeklyRefreshAsync"
                       StartIcon="@(_running ? Icons.Material.Filled.HourglassTop : Icons.Material.Filled.PlayArrow)">
                Run Weekly Refresh
            </MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="IsBusy" OnClick="RunLoadLinesAsync"
                       StartIcon="@Icons.Material.Filled.PriceChange">
                Load Lines
            </MudButton>
        </div>

        <MudDivider Class="my-2" />

        <!-- ── Season Setup + Roster Capacity (paired: setup creates the year's
             TeamRecords row, roster capacity populates ZRoster onto it - side
             by side as a visual cue that they're a two-step yearly pair) ── -->
        <MudGrid Spacing="2">
            <MudItem xs="12" md="5">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Season Setup</MudText>
                <div class="section-row">
                    <MudNumericField @bind-Value="_seasonYear" Label="Year" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Disabled="IsBusy" Class="param-field" />
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="IsBusy" OnClick="RunSeasonSetupAsync"
                               StartIcon="@(_running ? Icons.Material.Filled.HourglassTop : Icons.Material.Filled.PlayArrow)">
                        Run Season Setup
                    </MudButton>
                </div>
                <div class="section-row">
                    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="IsBusy" OnClick="CheckPortalCoverageAsync">
                        Check Portal Coverage
                    </MudButton>
                    @if (_portalCoverage is not null)
                    {
                        <span class="coverage-result @(_portalCoverage.MissingSeasons.Count == 0 ? "coverage-ok" : "coverage-warn")">
                            @(_portalCoverage.MissingSeasons.Count == 0
                                ? "All seasons covered"
                                : $"Missing: {string.Join(", ", _portalCoverage.MissingSeasons)}")
                        </span>
                    }
                </div>
                <div class="section-row">
                    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="IsBusy" OnClick="BackfillTierDiscountCoefficientsAsync">
                        Backfill Tier Discount Coefficients
                    </MudButton>
                </div>
                <div class="section-row">
                    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="IsBusy" OnClick="BackfillAnchorBlendCoefficientsAsync">
                        Backfill Anchor Blend Coefficients
                    </MudButton>
                </div>
            </MudItem>

            <MudItem xs="12" md="7">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Roster Capacity</MudText>
                <div class="section-row">
                    <MudNumericField @bind-Value="_rosterYear" Label="Year" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Disabled="IsBusy" Class="param-field" />
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="IsBusy" OnClick="RunRosterCapacityAllAsync"
                               StartIcon="@(_running ? Icons.Material.Filled.HourglassTop : Icons.Material.Filled.PlayArrow)">
                        Run All
                    </MudButton>
                </div>
                <div class="section-row">
                    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="IsBusy" OnClick="LoadRosterAsync">Load Roster</MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="IsBusy" OnClick="LoadStatsAsync">Load Stats</MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="IsBusy" OnClick="LoadCoachesAsync">Load Coaches</MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="IsBusy" OnClick="LoadRecruitingAsync">Load &amp; Apply Recruiting</MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="IsBusy" OnClick="LoadPortalRatingsAsync">Load &amp; Apply Portal Ratings</MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="IsBusy" OnClick="ComputeZRosterAsync">Compute Portal Metrics</MudButton>
                </div>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-2" />

        <!-- ── Postseason Tagging ──────────────────────────────── -->
        <MudText Typo="Typo.overline" Color="Color.Secondary">Postseason Tagging</MudText>
        <div class="section-row">
            <MudNumericField @bind-Value="_postseasonYear" Label="Year" Variant="Variant.Outlined" Margin="Margin.Dense"
                             Disabled="IsBusy" Class="param-field" />
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="IsBusy" OnClick="LoadPostseasonAsync"
                       StartIcon="@(_running ? Icons.Material.Filled.HourglassTop : Icons.Material.Filled.CloudDownload)">
                @(_running ? "Loading..." : "Load Postseason")
            </MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="IsBusy" OnClick="FetchPostseasonGamesAsync" StartIcon="@Icons.Material.Filled.Refresh">
                Refresh List
            </MudButton>
            <div style="flex:1"></div>
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" Disabled="@(IsBusy || _dirtyCount == 0)"
                       OnClick="SavePostseasonAsync" StartIcon="@Icons.Material.Filled.Save">
                Save (@_dirtyCount playoff)
            </MudButton>
        </div>

        @if (!_running && _gamesByWeek.Count > 0)
        {
            <p class="instructions">
                Check each CFP playoff game. Bowl games should remain unchecked. Hit <strong>Save</strong> when done.
            </p>

            @foreach (var group in _gamesByWeek)
            {
                <div class="week-group">
                    <div class="week-label" @onclick="() => ToggleWeek(group.Week)">
                        <MudIcon Icon="@(IsWeekCollapsed(group.Week) ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ExpandMore)" Class="chevron" />
                        <span class="week-title">Week @group.Week</span>
                        <span class="week-counts">
                            @if (group.BowlCount > 0)
                            {
                                <span class="count-bowl">Bowls (@group.BowlCount)</span>
                            }
                            @if (group.BowlCount > 0 && group.PlayoffCount > 0)
                            {
                                <span class="count-sep">·</span>
                            }
                            @if (group.PlayoffCount > 0)
                            {
                                <span class="count-playoff">Playoffs (@group.PlayoffCount)</span>
                            }
                        </span>
                    </div>

                    @if (!IsWeekCollapsed(group.Week))
                    {
                        <div class="game-list">
                            @foreach (var game in group.Games)
                            {
                                <div class="game-row @(IsChecked(game.Id) ? "tagged" : "")">
                                    <MudCheckBox T="bool" Value="IsChecked(game.Id)" Dense="true" ValueChanged="@((bool v) => TogglePlayoff(game.Id, v))" />
                                    <span class="matchup">@game.AwayName @@ @game.HomeName</span>
                                    <span class="game-date">@game.GameDay, @game.GameDate</span>
                                    <span class="season-type type-@game.SeasonType">@game.SeasonType</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
        else if (!_running && _gamesByWeek.Count == 0)
        {
            <div class="empty-state">
                <MudIcon Icon="@Icons.Material.Filled.SportsFootball" />
                <p>Set a year and click Load Postseason to fetch games from CFBD.</p>
            </div>
        }

    </div>

    <ActivityLogPanel Entries="_log" Running="_running" OnClear="ClearLog" />
</div>

@code {
    // Weekly / Season Setup state
    private int _weeklyYear = DateTime.Now.Year;
    private int _weeklyWeek = 1;
    private int _seasonYear = DateTime.Now.Year;
    private int _rosterYear = DateTime.Now.Year;

    // Postseason state
    private int _postseasonYear = DateTime.Now.Year;
    private List<PostseasonGameDto> _games = new();
    private List<WeekGroup> _gamesByWeek = new();
    private readonly HashSet<int> _playoffIds = new();
    private readonly HashSet<int> _collapsedWeeks = new();
    private int _dirtyCount => _playoffIds.Count;

    // Shared across all three sections - only one write operation runs at a time.
    private bool _running;
    private bool _saving;
    private bool IsBusy => _running || _saving;

    private readonly List<LogEntry> _log = new();

    private void Append(string message, LogStatus status = LogStatus.Info) =>
        _log.Add(new LogEntry(DateTime.Now.ToString("HH:mm:ss"), message, status));

    private void ClearLog() => _log.Clear();

    /// <summary>
    /// Mirrors the Angular `step()` helper: logs a "Starting..." line, awaits the
    /// call, logs success (using the response's "message" field if present) or
    /// failure, and rethrows on failure so the caller's try/catch can stop the chain.
    /// </summary>
    private async Task StepAsync(string label, Func<Task<JsonElement>> call)
    {
        Append($"Starting {label}...", LogStatus.Running);
        try
        {
            var result = await call();
            var message = result.ValueKind == JsonValueKind.Object && result.TryGetProperty("message", out var m)
                ? m.GetString()
                : null;
            Append($"\u2713 {message ?? $"{label} complete"}", LogStatus.Success);
        }
        catch (AdminApiException ex)
        {
            Append($"\u2717 {label} failed \u2014 {ex.Message}", LogStatus.Error);
            throw;
        }
    }

    // ── Weekly Operations ──────────────────────────────────────────────
    private async Task RunWeeklyRefreshAsync()
    {
        _running = true;
        Append($"\u2500\u2500 Weekly Refresh  Year={_weeklyYear}  Week={_weeklyWeek} \u2500\u2500");
        try
        {
            await StepAsync("Load Games", () => Api.LoadGamesAsync(_weeklyYear, _weeklyWeek));
            await StepAsync("Load Lines", () => Api.LoadLinesAsync(_weeklyYear, _weeklyWeek));
            await StepAsync("Update Team Records", () => Api.UpdateTeamRecordsAsync(_weeklyYear));
            // "Update Weekly Metrics" (TeamMetricsService.RecalculateMetricsAsync) removed —
            // its SOS/PowerRating/Ranking output was silently overwritten by
            // ComputeWeeklyAsync's step 15 (UpsertFromWeeklyRankingsAsync) one step
            // later, every week, and its PowerRating calc used GetGameParticipantsAsync
            // unfiltered by played status — unplayed games counted as 0-0 results in
            // the z-score average. TeamMetricsService removed entirely; see commit.
            await StepAsync("Compute Weekly Snapshot", () => Api.ComputeWeeklyAsync(_weeklyYear, _weeklyWeek));
            await StepAsync("Rolling Averages", () => Api.CalculateRollingAveragesAsync(_weeklyYear, _weeklyWeek));
            Append("\u2500\u2500 Complete \u2500\u2500", LogStatus.Success);
        }
        catch
        {
            Append("\u2500\u2500 Stopped due to error \u2500\u2500", LogStatus.Error);
        }
        finally
        {
            _running = false;
        }
    }

    private async Task RunLoadLinesAsync()
    {
        _running = true;
        Append($"\u2500\u2500 Load Lines  Year={_weeklyYear}  Week={_weeklyWeek} \u2500\u2500");
        try
        {
            await StepAsync("Load Lines", () => Api.LoadLinesAsync(_weeklyYear, _weeklyWeek));
            Append("\u2500\u2500 Complete \u2500\u2500", LogStatus.Success);
        }
        catch
        {
            Append("\u2500\u2500 Stopped due to error \u2500\u2500", LogStatus.Error);
        }
        finally
        {
            _running = false;
        }
    }

    // ── Season Setup ─────────────────────────────────────────────────────
    private PortalCoverageDto? _portalCoverage;

    private async Task CheckPortalCoverageAsync()
    {
        try
        {
            _portalCoverage = await Api.GetPortalCoverageAsync();
        }
        catch
        {
            Append("\u2717 Portal coverage check failed \u2014 check API logs", LogStatus.Error);
        }
    }

    private async Task BackfillTierDiscountCoefficientsAsync()
    {
        _running = true;
        Append($"\u2500\u2500 Backfill Tier Discount Coefficients  StartSeason=1965 \u2500\u2500");
        try
        {
            await StepAsync("Backfill Tier Discount Coefficients", () => Api.ComputeTierDiscountCoefficientsBulkAsync(1965));
            Append("\u2500\u2500 Complete \u2500\u2500", LogStatus.Success);
        }
        catch
        {
            Append("\u2500\u2500 Stopped due to error \u2500\u2500", LogStatus.Error);
        }
        finally
        {
            _running = false;
        }
    }

    private async Task BackfillAnchorBlendCoefficientsAsync()
    {
        _running = true;
        // StartSeason=1965 for consistency with the tier-discount backfill above,
        // same as that one it's a no-op until real data exists — ZRoster only
        // exists from 2020 onward, so every season before ~2023 (the first season
        // with a full 3-year trailing window of real ZRoster data) is skipped
        // automatically by AnchorBlendCalculator's own GamesUsed==0 check, not
        // treated as an error. See AnchorBlendCalculator remarks.
        Append($"\u2500\u2500 Backfill Anchor Blend Coefficients  StartSeason=1965 \u2500\u2500");
        try
        {
            await StepAsync("Backfill Anchor Blend Coefficients", () => Api.ComputeAnchorBlendCoefficientsBulkAsync(1965));
            Append("\u2500\u2500 Complete \u2500\u2500", LogStatus.Success);
        }
        catch
        {
            Append("\u2500\u2500 Stopped due to error \u2500\u2500", LogStatus.Error);
        }
        finally
        {
            _running = false;
        }
    }

    private async Task RunSeasonSetupAsync()
    {
        _running = true;
        Append($"\u2500\u2500 Season Setup  Year={_seasonYear} \u2500\u2500");
        try
        {
            await StepAsync("Load Conferences", () => Api.LoadConferencesAsync());
            await StepAsync("Load Teams", () => Api.LoadTeamsAsync(_seasonYear));
            await StepAsync("Build Conference History", () => Api.BuildTeamsConferenceHistoryAsync(1965));
            await StepAsync("Compute Tier Discount Coefficients", () => Api.ComputeTierDiscountCoefficientsAsync(_seasonYear));
            await StepAsync("Compute Anchor Blend Coefficients", () => Api.ComputeAnchorBlendCoefficientsAsync(_seasonYear));
            await StepAsync("Initialize Season", () => Api.InitializeSeasonAsync(_seasonYear));
            await StepAsync("Load Portal", () => Api.LoadPortalAsync(_seasonYear));
            await StepAsync("Compute Portal Metrics", () => Api.ComputePortalMetricsAsync(_seasonYear));
            Append("\u2500\u2500 Complete \u2500\u2500", LogStatus.Success);
        }
        catch
        {
            Append("\u2500\u2500 Stopped due to error \u2500\u2500", LogStatus.Error);
        }
        finally
        {
            _running = false;
        }
    }

    // ── Roster Capacity ─────────────────────────────────────────────────
    // No Angular equivalent - new admin capability for the CoachRecords/
    // PlayerStats/PortalEntries/RecruitPlayers/RosterPlayers tables.
    private async Task LoadRosterAsync()
    {
        _running = true;
        Append($"\u2500\u2500 Load Roster (Both Seasons)  Year={_rosterYear} \u2500\u2500");
        try
        {
            await StepAsync("Load Roster (Both Seasons)", () => Api.LoadRosterCapacityRosterBothSeasonsAsync(_rosterYear));
            Append("\u2500\u2500 Complete \u2500\u2500", LogStatus.Success);
        }
        catch
        {
            Append("\u2500\u2500 Stopped due to error \u2500\u2500", LogStatus.Error);
        }
        finally
        {
            _running = false;
        }
    }

    private async Task LoadStatsAsync()
    {
        _running = true;
        Append($"\u2500\u2500 Load Stats  Year={_rosterYear} \u2500\u2500");
        try
        {
            await StepAsync("Load Stats", () => Api.LoadRosterCapacityStatsAsync(_rosterYear));
            Append("\u2500\u2500 Complete \u2500\u2500", LogStatus.Success);
        }
        catch
        {
            Append("\u2500\u2500 Stopped due to error \u2500\u2500", LogStatus.Error);
        }
        finally
        {
            _running = false;
        }
    }

    private async Task LoadCoachesAsync()
    {
        _running = true;
        Append($"\u2500\u2500 Load Coaches  Year={_rosterYear} \u2500\u2500");
        try
        {
            await StepAsync("Load Coaches", () => Api.LoadRosterCapacityCoachesAsync(_rosterYear));
            Append("\u2500\u2500 Complete \u2500\u2500", LogStatus.Success);
        }
        catch
        {
            Append("\u2500\u2500 Stopped due to error \u2500\u2500", LogStatus.Error);
        }
        finally
        {
            _running = false;
        }
    }

    private async Task LoadRecruitingAsync()
    {
        _running = true;
        Append($"\u2500\u2500 Load & Apply Recruiting  Year={_rosterYear} \u2500\u2500");
        try
        {
            await StepAsync("Load & Apply Recruiting", () => Api.LoadAndApplyRosterCapacityRecruitingAsync(_rosterYear));
            Append("\u2500\u2500 Complete \u2500\u2500", LogStatus.Success);
        }
        catch
        {
            Append("\u2500\u2500 Stopped due to error \u2500\u2500", LogStatus.Error);
        }
        finally
        {
            _running = false;
        }
    }

    private async Task LoadPortalRatingsAsync()
    {
        _running = true;
        Append($"\u2500\u2500 Load & Apply Portal Ratings  Year={_rosterYear} \u2500\u2500");
        try
        {
            await StepAsync("Load & Apply Portal Ratings", () => Api.LoadAndApplyPortalRatingsAsync(_rosterYear));
            Append("\u2500\u2500 Complete \u2500\u2500", LogStatus.Success);
        }
        catch
        {
            Append("\u2500\u2500 Stopped due to error \u2500\u2500", LogStatus.Error);
        }
        finally
        {
            _running = false;
        }
    }

    private async Task ComputeZRosterAsync()
    {
        _running = true;
        Append($"\u2500\u2500 Compute Portal Metrics  Year={_rosterYear} \u2500\u2500");
        try
        {
            await StepAsync("Compute Portal Metrics", () => Api.ComputePortalMetricsAsync(_rosterYear));
            Append("\u2500\u2500 Complete \u2500\u2500", LogStatus.Success);
        }
        catch
        {
            Append("\u2500\u2500 Stopped due to error \u2500\u2500", LogStatus.Error);
        }
        finally
        {
            _running = false;
        }
    }

    // Runs every Roster Capacity step in dependency order: roster must be
    // loaded before recruiting/portal ratings can be joined onto it, and
    // Compute Portal Metrics (ZRoster) needs all of the above in place first.
    // Recruiting/Portal Ratings are applied for BOTH _rosterYear and
    // _rosterYear - 1 — the year-over-year talent delta (RosterCapacityService.
    // GetRosterZScoreDeltasAsync) needs real ratings on the prior season's
    // roster too, or every prior-year player falls to the flat baseline rating
    // and the delta is computed against a distorted population.
    private async Task RunRosterCapacityAllAsync()
    {
        _running = true;
        Append($"\u2500\u2500 Roster Capacity \u2014 Run All  Year={_rosterYear} \u2500\u2500");
        try
        {
            await StepAsync("Load Roster (Both Seasons)", () => Api.LoadRosterCapacityRosterBothSeasonsAsync(_rosterYear));
            await StepAsync("Load Stats", () => Api.LoadRosterCapacityStatsAsync(_rosterYear));
            await StepAsync("Load Coaches", () => Api.LoadRosterCapacityCoachesAsync(_rosterYear));
            await StepAsync("Load & Apply Recruiting", () => Api.LoadAndApplyRosterCapacityRecruitingAsync(_rosterYear));
            await StepAsync("Load & Apply Recruiting (Prior Season)", () => Api.LoadAndApplyRosterCapacityRecruitingAsync(_rosterYear - 1));
            await StepAsync("Load & Apply Portal Ratings", () => Api.LoadAndApplyPortalRatingsAsync(_rosterYear));
            await StepAsync("Load & Apply Portal Ratings (Prior Season)", () => Api.LoadAndApplyPortalRatingsAsync(_rosterYear - 1));
            await StepAsync("Compute Portal Metrics", () => Api.ComputePortalMetricsAsync(_rosterYear));
            Append("\u2500\u2500 Complete \u2500\u2500", LogStatus.Success);
        }
        catch
        {
            Append("\u2500\u2500 Stopped due to error \u2500\u2500", LogStatus.Error);
        }
        finally
        {
            _running = false;
        }
    }

    // ── Postseason Tagging ───────────────────────────────────────────────
    private async Task LoadPostseasonAsync()
    {
        _running = true;
        _games = new();
        _gamesByWeek = new();
        _playoffIds.Clear();
        _collapsedWeeks.Clear();
        Append($"\u2500\u2500 Load Postseason  Year={_postseasonYear} \u2500\u2500");

        try
        {
            await StepAsync("Load Postseason Games", () => Api.LoadPostseasonGamesAsync(_postseasonYear));
            await StepAsync("Assign Postseason Weeks", () => Api.AssignPostseasonWeeksAsync(_postseasonYear));
            Append("\u2500\u2500 Complete \u2014 loading game list \u2500\u2500", LogStatus.Success);
            await FetchPostseasonGamesAsync();
        }
        catch
        {
            Append("\u2500\u2500 Stopped due to error \u2500\u2500", LogStatus.Error);
            _running = false;
        }
    }

    private async Task FetchPostseasonGamesAsync()
    {
        try
        {
            _games = await Api.GetPostseasonGamesAsync(_postseasonYear);
            _playoffIds.Clear();
            foreach (var g in _games.Where(g => g.SeasonType == "playoff"))
                _playoffIds.Add(g.Id);
            _gamesByWeek = BuildWeekGroups(_games);
        }
        catch
        {
            Append("\u2717 Failed to load game list", LogStatus.Error);
        }
        finally
        {
            _running = false;
        }
    }

    private static List<WeekGroup> BuildWeekGroups(List<PostseasonGameDto> games) =>
        games.GroupBy(g => g.Week)
             .OrderBy(g => g.Key)
             .Select(g => new WeekGroup
             {
                 Week = g.Key,
                 Games = g.ToList(),
                 BowlCount = g.Count(x => x.SeasonType == "postseason"),
                 PlayoffCount = g.Count(x => x.SeasonType == "playoff"),
             })
             .ToList();

    private bool IsChecked(int gameId) => _playoffIds.Contains(gameId);

    private void TogglePlayoff(int gameId, bool isChecked)
    {
        if (isChecked) _playoffIds.Add(gameId);
        else _playoffIds.Remove(gameId);
        RefreshCounts();
    }

    private bool IsWeekCollapsed(int week) => _collapsedWeeks.Contains(week);

    private void ToggleWeek(int week)
    {
        if (_collapsedWeeks.Contains(week)) _collapsedWeeks.Remove(week);
        else _collapsedWeeks.Add(week);
    }

    // Recompute counts after a checkbox toggle without re-fetching - mirrors
    // refreshCounts() in the Angular original exactly (including the fact that
    // "bowl" here just means "currently unchecked", not literally seasonType).
    private void RefreshCounts()
    {
        foreach (var group in _gamesByWeek)
        {
            group.BowlCount = group.Games.Count(g => !IsChecked(g.Id));
            group.PlayoffCount = group.Games.Count(g => IsChecked(g.Id));
        }
    }

    private async Task SavePostseasonAsync()
    {
        _saving = true;
        var ids = _playoffIds.ToList();
        try
        {
            await Api.TagAsPlayoffAsync(ids);
            Snackbar.Add($"{ids.Count} game(s) tagged as playoff.", Severity.Success);
            _saving = false;
            await FetchPostseasonGamesAsync();
        }
        catch
        {
            Snackbar.Add("Save failed \u2014 check the API logs.", Severity.Error);
            _saving = false;
        }
    }
}
