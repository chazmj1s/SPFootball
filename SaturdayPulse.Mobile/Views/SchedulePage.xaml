<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SaturdayPulse.Models"
             xmlns:controls="clr-namespace:SaturdayPulse.Controls"
             xmlns:converters="clr-namespace:SaturdayPulse.Converters"
             x:Class="SaturdayPulse.Views.SchedulePage"
             x:Name="ThisPage"
             Shell.NavBarIsVisible="False">

  <ContentPage.Resources>
    <!-- Season Pass gating (2026-07-25) — masks projected Score/Spread/O-U
         numbers with a lock glyph for free users. Declared locally rather
         than in a global resource dictionary since App.xaml wasn't part of
         this pass. -->
    <converters:ProjectionGateConverter x:Key="ProjectionGateConverter" />
    <converters:RivalryNotesVisibilityConverter x:Key="RivalryNotesVisibilityConverter" />
    <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
  </ContentPage.Resources>


  <Grid RowDefinitions="Auto,*,24">

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ROW 1: Games list with pull-to-refresh              -->
    <!-- ═══════════════════════════════════════════════════ -->
    <RefreshView Grid.Row="1"
                 Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsRefreshing, Mode=OneWay}">

            <CollectionView x:Name="GamesCollectionView"
                            ItemsSource="{Binding Games}"
                            ItemSizingStrategy="MeasureAllItems">

                <CollectionView.ItemTemplate>
<DataTemplate x:DataType="models:GameResult">
    <VerticalStackLayout Spacing="0">

      <!-- Date group header -->
      <Grid BackgroundColor="{AppThemeBinding Light=#EBEBEB, Dark=#252525}"
            Padding="10,4,10,4"
            IsVisible="{Binding ShowGroupHeader}">
        <Label Text="{Binding GroupHeader}"
               FontSize="11" FontAttributes="Bold"
               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
               VerticalOptions="Center" />
      </Grid>

      <!-- Game card -->
      <!-- Columns: 0=heart 1=name 2-5=Q1-Q4 6=OT(Auto,
           collapses to ~0 width when HasOvertime is false and the
           label text is empty) 7=Total(actual/proj score) 8=Margin:O/U
           + time/status. Star moved to Grid.Row="0" Grid.Column="0"
           (2026-09-13) — same column as the hearts, header row above
           them. Week label dropped; that column's width now goes to
           the name column ('*'). 2-5/7/8 widths are estimated from the
           mockup screenshots, not measured on a real device — the name
           column will absorb whatever's wrong; expect to need a pass
           once this renders. -->
      <Grid ColumnDefinitions="18,*,20,20,20,20,Auto,52,100"
            RowDefinitions="Auto,Auto,Auto"
            Padding="6,5,10,5">

        <!-- Cross-tab highlight (2026-09-05) — My Teams' opponent-name
             navigation target. Overrides the odd-row background while
             active; reverts automatically once IsHighlighted goes false.
             IsHighlighted MUST stay declared last in this block — with
             multiple simultaneously-true DataTriggers on the same
             property, MAUI applies them in declaration order, so the
             last one wins. Un-converted from OddRowBackgroundConverter
             2026-09 (see chat) — same AppThemeBinding pattern, no color
             values changed. -->
        <Grid.Triggers>
          <DataTrigger TargetType="Grid" Binding="{Binding IsOddRow}" Value="True">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF8F0, Dark=#2A2A2A}" />
          </DataTrigger>
          <DataTrigger TargetType="Grid" Binding="{Binding IsOddRow}" Value="False">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1A1A1A}" />
          </DataTrigger>
          <DataTrigger TargetType="Grid" Binding="{Binding IsHighlighted}" Value="True">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF3CD, Dark=#4A3B00}" />
          </DataTrigger>
        </Grid.Triggers>

        <!-- Star game follow — moved into the header row, directly above
             the hearts column (2026-09-13). Week label dropped entirely
             (redundant with the week strip/tab); the column it and the
             star used to occupy is gone too, so its width goes straight
             to the name column ('*') instead of sitting unused. -->
        <controls:FollowGameIcon Grid.Row="0" Grid.Column="0"
              IsFollowed="{Binding IsGameFavorited}"
              VerticalOptions="Center" HorizontalOptions="Start">
          <controls:FollowGameIcon.GestureRecognizers>
            <TapGestureRecognizer
                  Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.TogglePersonalGameCommand}"
                  CommandParameter="{Binding .}" />
          </controls:FollowGameIcon.GestureRecognizers>
        </controls:FollowGameIcon>

        <!-- ── Row 0: quarter / total / margin-OU column headers ── -->
        <Label Grid.Row="0" Grid.Column="1" Text="        Team" FontSize="8" FontAttributes="Bold" Opacity="0.5" HorizontalOptions="Start" />
        <Label Grid.Row="0" Grid.Column="2" Text="1" FontSize="8" FontAttributes="Bold" Opacity="0.5" HorizontalOptions="Center" />
        <Label Grid.Row="0" Grid.Column="3" Text="2" FontSize="8" FontAttributes="Bold" Opacity="0.5" HorizontalOptions="Center" />
        <Label Grid.Row="0" Grid.Column="4" Text="3" FontSize="8" FontAttributes="Bold" Opacity="0.5" HorizontalOptions="Center" />
        <Label Grid.Row="0" Grid.Column="5" Text="4" FontSize="8" FontAttributes="Bold" Opacity="0.5" HorizontalOptions="Center" />
        <Label Grid.Row="0" Grid.Column="6" Text="{Binding OvertimeHeaderText}" FontSize="8" FontAttributes="Bold" Opacity="0.5"
               HorizontalOptions="Center" IsVisible="{Binding HasOvertime}" />
        <Label Grid.Row="0" Grid.Column="7" Text="Total" FontSize="8" FontAttributes="Bold" Opacity="0.5" HorizontalOptions="Center" />
        <Label Grid.Row="0" Grid.Column="8" Text="Margin : O/U" FontSize="8" FontAttributes="Bold" Opacity="0.5" HorizontalOptions="End" />

        <!-- ── Row 1: visitor (away) ── -->

        <!-- Heart: visitor -->
        <controls:FollowTeamIcon Grid.Row="1" Grid.Column="0"
              IsFollowed="{Binding VisitorIsFollowed}"
              VerticalOptions="Center" HorizontalOptions="Start">
          <controls:FollowTeamIcon.GestureRecognizers>
            <TapGestureRecognizer
                  Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleFollowCommand}"
                  CommandParameter="{Binding AwayId}" />
          </controls:FollowTeamIcon.GestureRecognizers>
        </controls:FollowTeamIcon>

        <Label Grid.Row="1" Grid.Column="1" Text="{Binding VisitorName}"
               FontSize="13" VerticalOptions="Center" LineBreakMode="TailTruncation"
               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
          <Label.GestureRecognizers>
            <TapGestureRecognizer
                  Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.NavigateToTeamCommand}"
                  CommandParameter="{Binding AwayId}" />
          </Label.GestureRecognizers>
        </Label>

        <Label Grid.Row="1" Grid.Column="2" Text="{Binding AwayQ1}"
               FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"
               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Label Grid.Row="1" Grid.Column="3" Text="{Binding AwayQ2}"
               FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"
               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Label Grid.Row="1" Grid.Column="4" Text="{Binding AwayQ3}"
               FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"
               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Label Grid.Row="1" Grid.Column="5" Text="{Binding AwayQ4}"
               FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"
               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Label Grid.Row="1" Grid.Column="6" Text="{Binding AwayOT}"
               FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"
               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
               IsVisible="{Binding HasOvertime}" />

        <Label Grid.Row="1" Grid.Column="7"
               FontSize="13" FontAttributes="Bold"
               HorizontalOptions="Center" VerticalOptions="Center"
               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
          <Label.Text>
            <MultiBinding Converter="{StaticResource ProjectionGateConverter}">
              <Binding Path="DisplayVisitorScore" />
              <Binding Source="{x:Reference ThisPage}" Path="BindingContext.HasSeasonPass" />
              <Binding Path="Year" />
            </MultiBinding>
          </Label.Text>
        </Label>

        <!-- ── Row 2: home ── -->

        <!-- Heart: home -->
        <controls:FollowTeamIcon Grid.Row="2" Grid.Column="0"
              IsFollowed="{Binding HomeIsFollowed}"
              VerticalOptions="Center" HorizontalOptions="Start">
          <controls:FollowTeamIcon.GestureRecognizers>
            <TapGestureRecognizer
                  Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleFollowCommand}"
                  CommandParameter="{Binding HomeId}" />
          </controls:FollowTeamIcon.GestureRecognizers>
        </controls:FollowTeamIcon>

        <Label Grid.Row="2" Grid.Column="1"
               FontSize="13" VerticalOptions="Center" LineBreakMode="TailTruncation">
          <Label.FormattedText>
            <FormattedString>
              <Span Text="{Binding HomeName}"
                    TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
              <Span Text="{Binding NeutralIndicator}" FontSize="10"
                    TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
            </FormattedString>
          </Label.FormattedText>
          <Label.GestureRecognizers>
            <TapGestureRecognizer
                  Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.NavigateToTeamCommand}"
                  CommandParameter="{Binding HomeId}" />
          </Label.GestureRecognizers>
        </Label>

        <Label Grid.Row="2" Grid.Column="2" Text="{Binding HomeQ1}"
               FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"
               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Label Grid.Row="2" Grid.Column="3" Text="{Binding HomeQ2}"
               FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"
               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Label Grid.Row="2" Grid.Column="4" Text="{Binding HomeQ3}"
               FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"
               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Label Grid.Row="2" Grid.Column="5" Text="{Binding HomeQ4}"
               FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"
               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Label Grid.Row="2" Grid.Column="6" Text="{Binding HomeOT}"
               FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"
               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
               IsVisible="{Binding HasOvertime}" />

        <Label Grid.Row="2" Grid.Column="7"
               FontSize="13" FontAttributes="Bold"
               HorizontalOptions="Center" VerticalOptions="Center"
               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
          <Label.Text>
            <MultiBinding Converter="{StaticResource ProjectionGateConverter}">
              <Binding Path="DisplayHomeScore" />
              <Binding Source="{x:Reference ThisPage}" Path="BindingContext.HasSeasonPass" />
              <Binding Path="Year" />
            </MultiBinding>
          </Label.Text>
        </Label>

        <!-- ── Margin : O/U (one line) + GameTime/Status (line below) ──
             Row-spanning across both team rows — one instance per card,
             not per team, since neither value is team-specific. -->
        <VerticalStackLayout Grid.Row="1" Grid.Column="8" Grid.RowSpan="2" Spacing="1"
               HorizontalOptions="End" VerticalOptions="Center">

          <HorizontalStackLayout Spacing="2" HorizontalOptions="End">
            <Label FontSize="10"
                   TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}">
              <Label.Text>
                <MultiBinding Converter="{StaticResource ProjectionGateConverter}">
                  <Binding Path="DisplayMarginValue" />
                  <Binding Source="{x:Reference ThisPage}" Path="BindingContext.HasSeasonPass" />
                  <Binding Path="Year" />
                </MultiBinding>
              </Label.Text>
            </Label>
            <Label Text=":" FontSize="10"
                   TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
            <Label FontSize="10"
                   TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}">
              <Label.Text>
                <MultiBinding Converter="{StaticResource ProjectionGateConverter}">
                  <Binding Path="DisplayOUValue" />
                  <Binding Source="{x:Reference ThisPage}" Path="BindingContext.HasSeasonPass" />
                  <Binding Path="Year" />
                </MultiBinding>
              </Label.Text>
            </Label>
          </HorizontalStackLayout>

          <!-- GameTime (scheduled) / DisplayGameStatus (in-progress or
               final) combined — see GameResult.DisplayGameTimeOrStatus. -->
          <Label Text="{Binding DisplayGameTimeOrStatus}"
                 FontSize="10" HorizontalOptions="End"
                 TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                 IsVisible="{Binding DisplayGameTimeOrStatus, Converter={StaticResource StringNotEmptyConverter}}" />
        </VerticalStackLayout>

      </Grid>

      <!-- ── Toggle bar ── -->
      <Grid ColumnDefinitions="Auto,*" Padding="6,2,6,2">
        <Grid.Triggers>
          <DataTrigger TargetType="Grid" Binding="{Binding IsOddRow}" Value="True">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF8F0, Dark=#2A2A2A}" />
          </DataTrigger>
          <DataTrigger TargetType="Grid" Binding="{Binding IsOddRow}" Value="False">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1A1A1A}" />
          </DataTrigger>
        </Grid.Triggers>

        <!-- Rivalry Notes link — left of Details. Hidden entirely (not just
             the inner content) unless the pair is one of the 52 curated
             rivalries AND the user is entitled — see
             RivalryNotesVisibilityConverter remarks for why this differs
             from Details' always-visible-with-inner-paywall pattern. -->
        <Border Grid.Column="0" HorizontalOptions="Start" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleRivalryNotesCommand}"
                CommandParameter="{Binding .}" />
          </Border.GestureRecognizers>
  <Label FontSize="11"
               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
          <Label.IsVisible>
            <MultiBinding Converter="{StaticResource RivalryNotesVisibilityConverter}">
              <Binding Path="RivalryNotes" />
              <Binding Source="{x:Reference ThisPage}" Path="BindingContext.HasSeasonPass" />
            </MultiBinding>
          </Label.IsVisible>
          <Label.FormattedText>
            <FormattedString>
              <Span Text="Rivalry " />
              <Span Text="{Binding RivalryExpandIcon}" FontSize="8" />
            </FormattedString>
          </Label.FormattedText>
          </Label>
</Border>

        <Border Grid.Column="1" HorizontalOptions="Center" IsVisible="{Binding ShowDetails}" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleDetailsCommand}"
                CommandParameter="{Binding .}" />
          </Border.GestureRecognizers>
  <Label FontSize="11"
               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
          <Label.FormattedText>
            <FormattedString>
              <Span Text="Details " />
              <Span Text="{Binding DetailsExpandIcon}" FontSize="8" />
            </FormattedString>
          </Label.FormattedText>
          </Label>
</Border>
      </Grid>

      <!-- ══════════════════════════════════════════════ -->
      <!-- Rivalry Notes panel — separate from Details, own -->
      <!-- expand state (IsRivalryNotesExpanded).            -->
      <!-- ══════════════════════════════════════════════ -->
      <VerticalStackLayout IsVisible="{Binding IsRivalryNotesExpanded}"
                           Spacing="0"
                           BackgroundColor="{AppThemeBinding Light={StaticResource PanelBackgroundLight}, Dark={StaticResource PanelBackgroundDark}}">

        <Label Text="{Binding RivalryNotes.DisplayHeader}"
               FontSize="11" FontAttributes="Bold"
               Padding="10,8,10,4"
               TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />

        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Padding="10,0,10,6" ColumnSpacing="4" RowSpacing="2">
          <Label Grid.Row="0" Grid.Column="0" Text="{Binding RivalryNotes.DisplayAverageSpread}"
                 FontSize="10" HorizontalOptions="Start"
                 TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
          <Label Grid.Row="0" Grid.Column="1" Text="{Binding RivalryNotes.DisplayAverageOU}"
                 FontSize="10" HorizontalOptions="Start"
                 TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
          <Label Grid.Row="1" Grid.Column="0" Text="{Binding RivalryNotes.DisplayUpsetChance}"
                 FontSize="10" HorizontalOptions="Start"
                 TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
          <Label Grid.Row="1" Grid.Column="1" Text="{Binding RivalryNotes.Series}"
                 FontSize="10" HorizontalOptions="Start"
                 TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        </Grid>

        <BoxView HeightRequest="1" Opacity="0.15" Margin="10,0"
                 Color="{AppThemeBinding Light=Black, Dark=White}" />

        <Label Text="{Binding RivalryNotes.Blurb}"
               FontSize="10" Opacity="0.85"
               Padding="10,6,10,8"
               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

      </VerticalStackLayout>

      <!-- ══════════════════════════════════════════════ -->
      <!-- Expanded details panel                         -->
      <!-- ══════════════════════════════════════════════ -->
      <VerticalStackLayout IsVisible="{Binding IsDetailsExpanded}"
                           Spacing="0"
                           BackgroundColor="{AppThemeBinding Light={StaticResource PanelBackgroundLight}, Dark={StaticResource PanelBackgroundDark}}">

        <!-- ── Vegas Lines section ── -->
        <!-- All rows share: 48=label | 70=Spread | 60=O/U | *=MoneyLine -->
        <VerticalStackLayout IsVisible="{Binding VegasLines.HasLines}" Spacing="0">

          <!-- Locked message — free users only. Exact copy from the
               2026-07-24 design pass. Tappable, wired to the shared
               SeasonPassCommand (same login-check EntitlementService uses
               for the Settings button and MyTeamsPage). -->
          <Grid IsVisible="{Binding Source={x:Reference ThisPage}, Path=BindingContext.IsNotSeasonPass}"
                Padding="10,10,10,10">
            <Border Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
                <TapGestureRecognizer
                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SeasonPassCommand}" />
              </Border.GestureRecognizers>
  <Label Text="🔒 Season Pass — Game History (1965–present), Vegas Spread, O/U, Money Line, Game Projections, and Sandbox team comparison. $9.95 unlocks the full season."
                   FontSize="11" HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
              </Label>
</Border>
          </Grid>

          <!-- Real Vegas content — Season Pass only -->
          <VerticalStackLayout IsVisible="{Binding Source={x:Reference ThisPage}, Path=BindingContext.HasSeasonPass}"
                               Spacing="0">

            <!-- Header row -->
            <Grid ColumnDefinitions="48,70,60,*" Padding="6,6,6,2" ColumnSpacing="4">
              <Label Grid.Column="0" Text="VEGAS"
                     FontSize="9" FontAttributes="Bold"
                     TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                     VerticalOptions="Center" />
              <Label Grid.Column="1" Text="— Spread —"
                     FontSize="9" Opacity="0.5" HorizontalOptions="Center" />
              <Label Grid.Column="2" Text="— O/U —"
                     FontSize="9" Opacity="0.5" HorizontalOptions="Center" />
              <Label Grid.Column="3" Text="— Money Line —"
                     FontSize="9" Opacity="0.5" HorizontalOptions="Center" />
            </Grid>

            <!-- Open row — away moneyline -->
            <Grid ColumnDefinitions="48,70,60,*" Padding="6,1,6,1" ColumnSpacing="4">
              <Label Grid.Column="0" Text="Open:"
                     FontSize="9" Opacity="0.6" VerticalOptions="Center" />
              <Label Grid.Column="1" Text="{Binding VegasLines.DisplaySpreadOpen}"
                     FontSize="10" FontAttributes="Bold" HorizontalOptions="Center"
                     TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
              <Label Grid.Column="2" Text="{Binding VegasLines.DisplayOUOpen}"
                     FontSize="10" FontAttributes="Bold" HorizontalOptions="Center"
                     TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
              <Label Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center">
                <Label.FormattedText>
                  <FormattedString>
                    <Span Text="{Binding AwayName}" FontSize="8"
                          TextColor="{AppThemeBinding Light=#CCCCCC, Dark=#CCCCCC}" />
                    <Span Text=": " FontSize="8"
                          TextColor="{AppThemeBinding Light=#CCCCCC, Dark=#CCCCCC}" />
                    <Span Text="{Binding VegasLines.DisplayAwayMoneyline}"
                          FontSize="10" FontAttributes="Bold"
                          TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                  </FormattedString>
                </Label.FormattedText>
              </Label>
            </Grid>

            <!-- Current row — home moneyline -->
            <Grid ColumnDefinitions="48,70,60,*" Padding="6,1,6,6" ColumnSpacing="4">
              <Label Grid.Column="0" Text="Current:"
                     FontSize="9" Opacity="0.6" VerticalOptions="Center" />
              <Label Grid.Column="1" Text="{Binding VegasLines.DisplaySpread}"
                     FontSize="10" FontAttributes="Bold" HorizontalOptions="Center"
                     TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
              <Label Grid.Column="2" Text="{Binding VegasLines.DisplayOU}"
                     FontSize="10" FontAttributes="Bold" HorizontalOptions="Center"
                     TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
              <Label Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center">
                <Label.FormattedText>
                  <FormattedString>
                    <Span Text="{Binding HomeName}" FontSize="8"
                          TextColor="{AppThemeBinding Light=#CCCCCC, Dark=#CCCCCC}" />
                    <Span Text=": " FontSize="8"
                          TextColor="{AppThemeBinding Light=#CCCCCC, Dark=#CCCCCC}" />
                    <Span Text="{Binding VegasLines.DisplayHomeMoneyline}"
                          FontSize="10" FontAttributes="Bold"
                          TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                  </FormattedString>
                </Label.FormattedText>
              </Label>
            </Grid>

          </VerticalStackLayout>

          <BoxView HeightRequest="1" Opacity="0.08" Margin="6,0"
                   Color="{AppThemeBinding Light=Black, Dark=White}" />

        </VerticalStackLayout>

        <!-- Inter-division message -->
        <Label IsVisible="{Binding IsInterDivision}"
               Text="Inter-division game — no ranking data available."
               FontSize="9" Opacity="0.5"
               HorizontalOptions="Center"
               Padding="8,10,8,10" />

        <!-- ── Team comparison table ── -->
        <VerticalStackLayout IsVisible="{Binding HasStats}" Spacing="0">

        <!-- Group header row -->
        <Grid ColumnDefinitions="*,44,44,44,38,44,38,44"
              Padding="8,6,8,0" ColumnSpacing="2">
          <Label Grid.Column="0" />
          <Label Grid.Column="1" />
          <Label Grid.Column="2" />
          <Label Grid.Column="3" />
          <Label Grid.Column="4" Grid.ColumnSpan="2"
                 Text="— Offense —"
                 FontSize="8" FontAttributes="Bold" Opacity="0.5"
                 HorizontalOptions="Center" />
          <Label Grid.Column="6" Grid.ColumnSpan="2"
                 Text="— Defense —"
                 FontSize="8" FontAttributes="Bold" Opacity="0.5"
                 HorizontalOptions="Center" />
        </Grid>

        <!-- Column headers -->
        <Grid ColumnDefinitions="*,44,44,44,38,44,38,44"
              Padding="8,0,8,2" ColumnSpacing="2">
          <Label Grid.Column="0" Text="Team"     FontSize="8" FontAttributes="Bold" Opacity="0.5" />
          <Label Grid.Column="1" Text="Rec"      FontSize="8" FontAttributes="Bold" Opacity="0.5" HorizontalOptions="Center" />
          <Label Grid.Column="2" Text="Rating"   FontSize="8" FontAttributes="Bold" Opacity="0.5" HorizontalOptions="Center" />
          <Label Grid.Column="3" Text="SOS"      FontSize="8" FontAttributes="Bold" Opacity="0.5" HorizontalOptions="Center" />
          <Label Grid.Column="4" Text="Rank"     FontSize="8" FontAttributes="Bold" Opacity="0.5" HorizontalOptions="Center" />
          <Label Grid.Column="5" Text="Avg Pts"  FontSize="8" FontAttributes="Bold" Opacity="0.5" HorizontalOptions="Center" />
          <Label Grid.Column="6" Text="Rank"     FontSize="8" FontAttributes="Bold" Opacity="0.5" HorizontalOptions="Center" />
          <Label Grid.Column="7" Text="Avg Pts"  FontSize="8" FontAttributes="Bold" Opacity="0.5" HorizontalOptions="Center" />
        </Grid>

        <BoxView HeightRequest="1" Opacity="0.08" Margin="8,0"
                 Color="{AppThemeBinding Light=Black, Dark=White}" />

        <!-- Away team row -->
        <Grid ColumnDefinitions="*,44,44,44,38,44,38,44"
              Padding="8,3,8,3" ColumnSpacing="2">
          <Label Grid.Column="0" Text="{Binding AwayStats.TeamName}"
                 FontSize="9" FontAttributes="Bold" LineBreakMode="TailTruncation"
                 TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
          <Label Grid.Column="1" Text="{Binding AwayStats.Record}"
                 FontSize="9" HorizontalOptions="Center" />
          <Label Grid.Column="2" Text="{Binding AwayStats.DisplayRating}"
                 FontSize="9" HorizontalOptions="Center"
                 TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
          <Label Grid.Column="3" Text="{Binding AwayStats.DisplaySOS}"
                 FontSize="9" HorizontalOptions="Center" />
          <Label Grid.Column="4" Text="{Binding AwayStats.DisplayOffRank}"
                 FontSize="9" HorizontalOptions="Center"
                 TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
          <Label Grid.Column="5" Text="{Binding AwayStats.DisplayPtsScored}"
                 FontSize="9" HorizontalOptions="Center" />
          <Label Grid.Column="6" Text="{Binding AwayStats.DisplayDefRank}"
                 FontSize="9" HorizontalOptions="Center"
                 TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
          <Label Grid.Column="7" Text="{Binding AwayStats.DisplayPtsAllowed}"
                 FontSize="9" HorizontalOptions="Center" />
        </Grid>

        <BoxView HeightRequest="1" Opacity="0.05" Margin="8,0"
                 Color="{AppThemeBinding Light=Black, Dark=White}" />

        <!-- Home team row -->
        <Grid ColumnDefinitions="*,44,44,44,38,44,38,44"
              Padding="8,3,8,6" ColumnSpacing="2">
          <Label Grid.Column="0" Text="{Binding HomeStats.TeamName}"
                 FontSize="9" FontAttributes="Bold" LineBreakMode="TailTruncation"
                 TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
          <Label Grid.Column="1" Text="{Binding HomeStats.Record}"
                 FontSize="9" HorizontalOptions="Center" />
          <Label Grid.Column="2" Text="{Binding HomeStats.DisplayRating}"
                 FontSize="9" HorizontalOptions="Center"
                 TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
          <Label Grid.Column="3" Text="{Binding HomeStats.DisplaySOS}"
                 FontSize="9" HorizontalOptions="Center" />
          <Label Grid.Column="4" Text="{Binding HomeStats.DisplayOffRank}"
                 FontSize="9" HorizontalOptions="Center"
                 TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
          <Label Grid.Column="5" Text="{Binding HomeStats.DisplayPtsScored}"
                 FontSize="9" HorizontalOptions="Center" />
          <Label Grid.Column="6" Text="{Binding HomeStats.DisplayDefRank}"
                 FontSize="9" HorizontalOptions="Center"
                 TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
          <Label Grid.Column="7" Text="{Binding HomeStats.DisplayPtsAllowed}"
                 FontSize="9" HorizontalOptions="Center" />
        </Grid>

        </VerticalStackLayout>

      </VerticalStackLayout>

      <BoxView HeightRequest="1" Opacity="0.10"
               Color="{AppThemeBinding Light=Black, Dark=White}" />

    </VerticalStackLayout>
  </DataTemplate>
</CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
                        <Label Text="{Binding EmptyMessage}" FontSize="14" Opacity="0.7"
                    HorizontalOptions="Center" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

            </CollectionView>

    </RefreshView>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ROW 2: Status bar                                   -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Grid Grid.Row="2" HeightRequest="24"
          BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}">
      <Label Text="( ) = projected value : All times Eastern Time"
             Padding="8,0" FontSize="11" FontAttributes="Italic"
             VerticalOptions="Center" HorizontalOptions="Start"
             TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}" />
    </Grid>

  </Grid>
</ContentPage>
