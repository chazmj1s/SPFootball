            <Label Grid.Column="0" />
            <Label Grid.Column="1" />
            <Label Grid.Column="2" />
            <Label Grid.Column="3" />
            <Label Grid.Column="4" Grid.ColumnSpan="2"
                   Text="— Offense —"
                   FontSize="8" FontAttributes="Bold" Opacity="0.5"
                   HorizontalOptions="Center" />
            <Label Grid.Column="6" Grid.ColumnSpan="2"
                   Text="— Defense —"
                   FontSize="8" FontAttributes="Bold" Opacity="0.5"
                   HorizontalOptions="Center" />
          </Grid>

          <Grid ColumnDefinitions="*,44,44,44,38,44,38,44"
                Padding="8,0,8,2" ColumnSpacing="2">
            <Label Grid.Column="0" Text="Team"     FontSize="8" FontAttributes="Bold" Opacity="0.5" />
            <Label Grid.Column="1" Text="Rec"      FontSize="8" FontAttributes="Bold" Opacity="0.5" HorizontalOptions="Center" />
            <Label Grid.Column="2" Text="Rating"   FontSize="8" FontAttributes="Bold" Opacity="0.5" HorizontalOptions="Center" />
            <Label Grid.Column="3" Text="SOS"      FontSize="8" FontAttributes="Bold" Opacity="0.5" HorizontalOptions="Center" />
            <Label Grid.Column="4" Text="Rank"     FontSize="8" FontAttributes="Bold" Opacity="0.5" HorizontalOptions="Center" />
            <Label Grid.Column="5" Text="Avg Pts"  FontSize="8" FontAttributes="Bold" Opacity="0.5" HorizontalOptions="Center" />
            <Label Grid.Column="6" Text="Rank"     FontSize="8" FontAttributes="Bold" Opacity="0.5" HorizontalOptions="Center" />
            <Label Grid.Column="7" Text="Avg Pts"  FontSize="8" FontAttributes="Bold" Opacity="0.5" HorizontalOptions="Center" />
          </Grid>

          <BoxView HeightRequest="1" Opacity="0.08" Margin="8,0"
                   Color="{AppThemeBinding Light=Black, Dark=White}" />

          <!-- Away team row -->
          <Grid ColumnDefinitions="*,44,44,44,38,44,38,44"
                Padding="8,3,8,3" ColumnSpacing="2">
            <Label Grid.Column="0" Text="{Binding AwayStats.TeamName}"
                   FontSize="9" FontAttributes="Bold" LineBreakMode="TailTruncation"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
            <Label Grid.Column="1" Text="{Binding AwayStats.Record}"
                   FontSize="9" HorizontalOptions="Center" />
            <Label Grid.Column="2" Text="{Binding AwayStats.DisplayRating}"
                   FontSize="9" HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
            <Label Grid.Column="3" Text="{Binding AwayStats.DisplaySOS}"
                   FontSize="9" HorizontalOptions="Center" />
            <Label Grid.Column="4" Text="{Binding AwayStats.DisplayOffRank}"
                   FontSize="9" HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
            <Label Grid.Column="5" Text="{Binding AwayStats.DisplayPtsScored}"
                   FontSize="9" HorizontalOptions="Center" />
            <Label Grid.Column="6" Text="{Binding AwayStats.DisplayDefRank}"
                   FontSize="9" HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
            <Label Grid.Column="7" Text="{Binding AwayStats.DisplayPtsAllowed}"
                   FontSize="9" HorizontalOptions="Center" />
          </Grid>

          <BoxView HeightRequest="1" Opacity="0.05" Margin="8,0"
                   Color="{AppThemeBinding Light=Black, Dark=White}" />

          <!-- Home team row -->
          <Grid ColumnDefinitions="*,44,44,44,38,44,38,44"
                Padding="8,3,8,6" ColumnSpacing="2">
            <Label Grid.Column="0" Text="{Binding HomeStats.TeamName}"
                   FontSize="9" FontAttributes="Bold" LineBreakMode="TailTruncation"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
            <Label Grid.Column="1" Text="{Binding HomeStats.Record}"
                   FontSize="9" HorizontalOptions="Center" />
            <Label Grid.Column="2" Text="{Binding HomeStats.DisplayRating}"
                   FontSize="9" HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
            <Label Grid.Column="3" Text="{Binding HomeStats.DisplaySOS}"
                   FontSize="9" HorizontalOptions="Center" />
            <Label Grid.Column="4" Text="{Binding HomeStats.DisplayOffRank}"
                   FontSize="9" HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
            <Label Grid.Column="5" Text="{Binding HomeStats.DisplayPtsScored}"
                   FontSize="9" HorizontalOptions="Center" />
            <Label Grid.Column="6" Text="{Binding HomeStats.DisplayDefRank}"
                   FontSize="9" HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
            <Label Grid.Column="7" Text="{Binding HomeStats.DisplayPtsAllowed}"
                   FontSize="9" HorizontalOptions="Center" />
          </Grid>

        </VerticalStackLayout>

      </VerticalStackLayout>
    </DataTemplate>

  </ContentPage.Resources>

  <Grid RowDefinitions="Auto,*,24">

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ROW 0: Title Games | Playoffs | Bowls               -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Grid Grid.Row="0"
          ColumnDefinitions="*,*,*"
          BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#1E1E1E}"
          Padding="8,4">

      <Border Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding SelectViewCommand}" CommandParameter="Championship" />
        </Border.GestureRecognizers>
  <Label Text="Title Games"
             FontSize="14" FontAttributes="Bold">
        <Label.Triggers>
          <DataTrigger TargetType="Label" Binding="{Binding IsChampionshipView}" Value="True">
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
            <Setter Property="TextDecorations" Value="Underline" />
          </DataTrigger>
          <DataTrigger TargetType="Label" Binding="{Binding IsChampionshipView}" Value="False">
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#888888, Dark=#666666}" />
            <Setter Property="TextDecorations" Value="None" />
          </DataTrigger>
        </Label.Triggers>
        </Label>
</Border>

      <Border Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding SelectViewCommand}" CommandParameter="Playoffs" />
        </Border.GestureRecognizers>
  <Label Text="Playoffs"
             FontSize="14" FontAttributes="Bold">
        <Label.Triggers>
          <DataTrigger TargetType="Label" Binding="{Binding IsPlayoffsView}" Value="True">
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
            <Setter Property="TextDecorations" Value="Underline" />
          </DataTrigger>
          <DataTrigger TargetType="Label" Binding="{Binding IsPlayoffsView}" Value="False">
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#888888, Dark=#666666}" />
            <Setter Property="TextDecorations" Value="None" />
          </DataTrigger>
        </Label.Triggers>
        </Label>
</Border>

      <Border Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding SelectViewCommand}" CommandParameter="Bowls" />
        </Border.GestureRecognizers>
  <Label Text="Bowls"
             FontSize="14" FontAttributes="Bold">
        <Label.Triggers>
          <DataTrigger TargetType="Label" Binding="{Binding IsBowlsView}" Value="True">
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}" />
            <Setter Property="TextDecorations" Value="Underline" />
          </DataTrigger>
          <DataTrigger TargetType="Label" Binding="{Binding IsBowlsView}" Value="False">
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#888888, Dark=#666666}" />
            <Setter Property="TextDecorations" Value="None" />
          </DataTrigger>
        </Label.Triggers>
        </Label>
</Border>

    </Grid>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ROW 1: Content area                                  -->
    <!-- ═══════════════════════════════════════════════════ -->

    <!-- ─────────────────── PLAYOFFS VIEW ─────────────────── -->
    <RefreshView Grid.Row="1"
                 Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsLoading}"
                 IsVisible="False">
      <RefreshView.Triggers>
        <DataTrigger TargetType="RefreshView" Binding="{Binding IsPlayoffsView}" Value="True">
          <Setter Property="IsVisible" Value="True" />
        </DataTrigger>
      </RefreshView.Triggers>

      <ScrollView>
        <VerticalStackLayout Spacing="0">

          <Label IsVisible="{Binding HasPlayoffData, Converter={StaticResource InvertedBoolConverter}}"
                 Text="{Binding StatusMessage}"
                 FontSize="13" Opacity="0.6" HorizontalOptions="Center"
                 Margin="0,40,0,0"
                 TextColor="{AppThemeBinding Light=#888888, Dark=#777777}" />

          <VerticalStackLayout IsVisible="{Binding HasPlayoffData}"
                               BindableLayout.ItemsSource="{Binding PlayoffRounds}"
                               Spacing="0">
            <BindableLayout.ItemTemplate>
              <DataTemplate x:DataType="vm:PlayoffRound">
                <VerticalStackLayout Spacing="0">

                  <!-- Round header — tappable to collapse/expand -->
                  <Grid BackgroundColor="{AppThemeBinding Light=#6B4EAE, Dark=#2A2040}"
                        Padding="12,8" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{Binding RoundLabel}"
                           FontSize="13" FontAttributes="Bold" TextColor="White"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding ExpandIcon}"
                           FontSize="10" TextColor="White"
                           VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                      <TapGestureRecognizer
                          Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleRoundExpandCommand}"
                          CommandParameter="{Binding .}" />
                    </Grid.GestureRecognizers>
                  </Grid>

                  <!-- Days — collapsible -->
                  <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                       BindableLayout.ItemsSource="{Binding Days}" Spacing="0">
                    <BindableLayout.ItemTemplate>
                      <DataTemplate x:DataType="vm:PlayoffDayGroup">
                        <VerticalStackLayout Spacing="0">

                          <!-- Day header -->
                          <Grid BackgroundColor="{AppThemeBinding Light=#EBEBEB, Dark=#252525}"
                                Padding="10,4">
                            <Label Text="{Binding DateLabel}"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                                   VerticalOptions="Center" />
                          </Grid>

                          <!-- Games — use the shared GameResultCard template -->
                          <VerticalStackLayout BindableLayout.ItemsSource="{Binding Games}" Spacing="0"
                                               BindableLayout.ItemTemplate="{StaticResource GameResultCard}" />

                        </VerticalStackLayout>
                      </DataTemplate>
                    </BindableLayout.ItemTemplate>
                  </VerticalStackLayout>

                </VerticalStackLayout>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </VerticalStackLayout>

        </VerticalStackLayout>
      </ScrollView>
    </RefreshView>

    <!-- ─────────────────── BOWLS VIEW ─────────────────── -->
    <RefreshView Grid.Row="1"
                 Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsLoading}"
                 IsVisible="False">
      <RefreshView.Triggers>
        <DataTrigger TargetType="RefreshView" Binding="{Binding IsBowlsView}" Value="True">
          <Setter Property="IsVisible" Value="True" />
        </DataTrigger>
      </RefreshView.Triggers>

      <ScrollView>
        <VerticalStackLayout Spacing="0">

          <Label IsVisible="{Binding HasBowlData, Converter={StaticResource InvertedBoolConverter}}"
                 Text="{Binding StatusMessage}"
                 FontSize="13" Opacity="0.6" HorizontalOptions="Center"
                 Margin="0,40,0,0"
                 TextColor="{AppThemeBinding Light=#888888, Dark=#777777}" />

          <VerticalStackLayout IsVisible="{Binding HasBowlData}"
                               BindableLayout.ItemsSource="{Binding BowlWeekends}"
                               Spacing="0">
            <BindableLayout.ItemTemplate>
              <DataTemplate x:DataType="vm:BowlWeekendGroup">
                <VerticalStackLayout Spacing="0">

                  <!-- Weekend header — tappable to collapse/expand -->
                  <Grid BackgroundColor="{AppThemeBinding Light=#6B4EAE, Dark=#2A2040}"
                        Padding="12,8" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{Binding WeekendLabel}"
                           FontSize="13" FontAttributes="Bold" TextColor="White"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding ExpandIcon}"
                           FontSize="10" TextColor="White"
                           VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                      <TapGestureRecognizer
                          Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleWeekendExpandCommand}"
                          CommandParameter="{Binding .}" />
                    </Grid.GestureRecognizers>
                  </Grid>

                  <!-- Days — collapsible -->
                  <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                       BindableLayout.ItemsSource="{Binding Days}" Spacing="0">
                    <BindableLayout.ItemTemplate>
                      <DataTemplate x:DataType="vm:BowlDayGroup">
                        <VerticalStackLayout Spacing="0">

                          <!-- Day header -->
                          <Grid BackgroundColor="{AppThemeBinding Light=#EBEBEB, Dark=#252525}"
                                Padding="10,4">
                            <Label Text="{Binding DateLabel}"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                                   VerticalOptions="Center" />
                          </Grid>

                          <!-- Games — same shared template -->
                          <VerticalStackLayout BindableLayout.ItemsSource="{Binding Games}" Spacing="0"
                                               BindableLayout.ItemTemplate="{StaticResource GameResultCard}" />

                        </VerticalStackLayout>
                      </DataTemplate>
                    </BindableLayout.ItemTemplate>
                  </VerticalStackLayout>

                </VerticalStackLayout>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </VerticalStackLayout>

        </VerticalStackLayout>
      </ScrollView>
    </RefreshView>

    <!-- ─────────────────── TITLE GAMES VIEW ─────────────────── -->
    <RefreshView Grid.Row="1"
                 Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsLoading}"
                 IsVisible="False">
      <RefreshView.Triggers>
        <DataTrigger TargetType="RefreshView" Binding="{Binding IsChampionshipView}" Value="True">
          <Setter Property="IsVisible" Value="True" />
        </DataTrigger>
      </RefreshView.Triggers>

        <CollectionView ItemsSource="{Binding Championships}"
                        ItemSizingStrategy="MeasureAllItems">
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="models:ChampionshipMatchup">
            <VerticalStackLayout Spacing="0">

              <!-- Conference header -->
              <Grid BackgroundColor="{AppThemeBinding Light=#6B4EAE, Dark=#2A2040}" Padding="12,8">
                <Label Text="{Binding Conference}"
                       FontSize="13" FontAttributes="Bold" TextColor="White" />
              </Grid>

              <!-- Card A: real Game exists — CFBD has published the title game.
                   Uses GameResultCardBody (score only, no built-in Details toggle) —
                   the Details toggle for this card now lives in the shared
                   Tiebreaker/Details/Contenders row below instead. -->
              <VerticalStackLayout Spacing="0" IsVisible="{Binding HasGame}"
                                   BindableLayout.ItemsSource="{Binding GameList}"
                                   BindableLayout.ItemTemplate="{StaticResource GameResultCardBody}" />

              <!-- Card B: no real Game yet — Sandbox-style end-of-season projection,
                   built from GetSandboxPredictionAsync + GetPowerRankingsAsync in
                   PostseasonViewModel.EnrichChampionshipsWithPredictionsAsync. -->
              <VerticalStackLayout Spacing="0" IsVisible="{Binding NeedsPrediction}">

                <Grid BackgroundColor="{AppThemeBinding Light=#EBEBEB, Dark=#252525}" Padding="10,4">
                  <Label Text="Neutral Site · End-of-Season Ratings"
                         FontSize="11" FontAttributes="Bold"
                         TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}"
                         VerticalOptions="Center" />
                </Grid>

                <VerticalStackLayout IsVisible="{Binding HasPrediction}" Spacing="0">

                  <Grid ColumnDefinitions="32,*,60,96" Padding="6,5,10,2"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A2E}">
                    <Label Grid.Column="0" Text="{Binding Prediction.TeamYear}"
                           FontSize="10"
                           TextColor="{AppThemeBinding Light=#AAAAAA, Dark=#555555}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding Prediction.TeamName}"
                           FontSize="13" VerticalOptions="Center"
                           LineBreakMode="TailTruncation" />
                    <Label Grid.Column="2" Text="{Binding Prediction.TeamScore}"
                           FontSize="13" FontAttributes="Bold"
                           HorizontalOptions="End" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Grid.Column="3" Text="{Binding Prediction.MarginDisplay}"
                           FontSize="11" HorizontalOptions="End" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
                  </Grid>

                  <Grid ColumnDefinitions="32,*,60,96" Padding="6,2,10,5"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A2E}">
                    <Label Grid.Column="0" Text="{Binding Prediction.OpponentYear}"
                           FontSize="10"
                           TextColor="{AppThemeBinding Light=#AAAAAA, Dark=#555555}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding Prediction.OpponentName}"
                           FontSize="13" VerticalOptions="Center"
                           LineBreakMode="TailTruncation" />
                    <Label Grid.Column="2" Text="{Binding Prediction.OppScore}"
                           FontSize="13" FontAttributes="Bold"
                           HorizontalOptions="End" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Grid.Column="3" HorizontalOptions="End" VerticalOptions="Center"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#999999}">
                      <Label.FormattedText>
                        <FormattedString>
                          <Span Text="± " />
                          <Span Text="{Binding Prediction.MarginOfError, StringFormat='{0:F1}'}" />
                          <Span Text=" pts" />
                        </FormattedString>
                      </Label.FormattedText>
                    </Label>
                  </Grid>

                  <BoxView HeightRequest="1" Opacity="0.10"
                           Color="{AppThemeBinding Light=Black, Dark=White}" />

                </VerticalStackLayout>

              </VerticalStackLayout>

              <!-- Tiebreaker + Details + Contenders — one shared row. The Details
                   slot routes to whichever card is active (real Game or Sandbox)
                   via ShowDetailsToggle/DetailsToggleIcon/ToggleTitleGameDetailsCommand. -->
              <Grid ColumnDefinitions="*,*,*" Padding="12,2,16,6">
                <Border Grid.Column="0" IsVisible="{Binding HasTiebreaker}" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleMatchupExpandCommand}"
                        CommandParameter="{Binding .}" />
                  </Border.GestureRecognizers>
  <Label
                       FontSize="11" LineBreakMode="TailTruncation" TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
                  <Label.FormattedText>
                    <FormattedString>
                      <Span Text="{Binding TiebreakerSummary}" />
                      <Span Text="  " />
                      <Span Text="{Binding ExpandIcon}" FontSize="8" />
                    </FormattedString>
                  </Label.FormattedText>
                  </Label>
</Border>
                <Border Grid.Column="1" HorizontalOptions="Center" IsVisible="{Binding ShowDetailsToggle}" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleTitleGameDetailsCommand}"
                        CommandParameter="{Binding .}" />
                  </Border.GestureRecognizers>
  <Label
                       FontSize="11" LineBreakMode="TailTruncation"
                       TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
                  <Label.FormattedText>
                    <FormattedString>
                      <Span Text="Details " />
                      <Span Text="{Binding DetailsToggleIcon}" FontSize="8" />
                    </FormattedString>
                  </Label.FormattedText>
                  </Label>
</Border>
                <Border Grid.Column="2" HorizontalOptions="End" IsVisible="{Binding HasContenders}" Padding="4,6" StrokeThickness="0" BackgroundColor="Transparent">
  <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleContendersExpandCommand}"
                        CommandParameter="{Binding .}" />
                  </Border.GestureRecognizers>
  <Label
                       FontSize="11" LineBreakMode="TailTruncation"
                       TextColor="{AppThemeBinding Light={StaticResource AccentPrimaryLight}, Dark={StaticResource AccentPrimaryDark}}">
                  <Label.FormattedText>
                    <FormattedString>
                      <Span Text="Contenders" />
                      <Span Text="  " />
                      <Span Text="{Binding ContendersExpandIcon}" FontSize="8" />
                    </FormattedString>
                  </Label.FormattedText>
                  </Label>
</Border>
              </Grid>

              <!-- Card A's expanded Details panel (Vegas + team stats), directly
                   below the toggle row. GameList is the same zero/one-item list
                   Card A's body uses, so this naturally draws nothing when
                   Game is null. -->
              <VerticalStackLayout Spacing="0" IsVisible="{Binding HasGame}"
                                   BindableLayout.ItemsSource="{Binding GameList}"
                                   BindableLayout.ItemTemplate="{StaticResource GameResultDetailsPanelOnly}" />

              <!-- Sandbox card's expanded Details panel — directly below its
                   toggle in the row above, matching how Tiebreaker/Contenders
                   expand below theirs. IsSandboxDetailsExpanded only ever
                   flips true via the Sandbox card's own toggle, so this stays
                   collapsed and harmless on the real-Game (Card A) path. -->
              <VerticalStackLayout IsVisible="{Binding IsSandboxDetailsExpanded}"
                                   Spacing="0"
                                   BackgroundColor="{AppThemeBinding Light={StaticResource PanelBackgroundLight}, Dark={StaticResource PanelBackgroundDark}}">

                <Grid ColumnDefinitions="44,22,*,55,70,60" Padding="8,6,8,2">
                  <Label Grid.Column="0" Text="Rank" FontSize="9" FontAttributes="Bold" Opacity="0.5" HorizontalOptions="Center" />
                  <Label Grid.Column="3" Text="Rec" FontSize="9" FontAttributes="Bold" Opacity="0.5" />
                  <Label Grid.Column="4" Text="Rating" FontSize="9" FontAttributes="Bold" Opacity="0.5" />
                  <Label Grid.Column="5" Text="SOS" FontSize="9" FontAttributes="Bold" Opacity="0.5" />
                </Grid>

                <BoxView HeightRequest="1" Opacity="0.08" Margin="8,0"
                         Color="{AppThemeBinding Light=Black, Dark=White}" />

                <!-- Qualifier1 row -->
                <Grid ColumnDefinitions="44,22,*,55,70,60" Padding="8,4,8,3">
                  <Grid Grid.Column="0" HeightRequest="26" WidthRequest="40"
                        HorizontalOptions="Center" VerticalOptions="Center">
                    <BoxView CornerRadius="3"
                             Color="{Binding Qualifier1Ranking.IsTop25, Converter={StaticResource BoolToColorConverter}}" />
                    <Label Text="{Binding Qualifier1Ranking.OverallRank}"
                           FontSize="10" FontAttributes="Bold" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                  </Grid>
                  <Label Grid.Column="1"
                         Text="{Binding Qualifier1Ranking.IsFollowed, Converter={StaticResource FollowTeamGlyphConverter}}"
                         TextColor="{Binding Qualifier1Ranking.IsFollowed, Converter={StaticResource FollowTeamColorConverter}}"
                         FontSize="{StaticResource TeamIconSize}"
                         VerticalOptions="Center" HorizontalOptions="Center" />
                  <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
                    <Label Text="{Binding Qualifier1.TeamName}" FontSize="12" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding Qualifier1Ranking.DisplayConferenceTier}"
                           FontSize="9" Opacity="0.6" LineBreakMode="TailTruncation" />
                  </VerticalStackLayout>
                  <Label Grid.Column="3" Text="{Binding Qualifier1Ranking.Record}" FontSize="10" VerticalOptions="Center" />
                  <Label Grid.Column="4" Text="{Binding Qualifier1Ranking.DisplayRank}" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
                  <Label Grid.Column="5" Text="{Binding Qualifier1Ranking.DisplaySOS}" FontSize="10" VerticalOptions="Center" />
                </Grid>

                <BoxView HeightRequest="1" Opacity="0.05" Margin="8,0"
                         Color="{AppThemeBinding Light=Black, Dark=White}" />

                <!-- Qualifier2 row -->
                <Grid ColumnDefinitions="44,22,*,55,70,60" Padding="8,3,8,6">
                  <Grid Grid.Column="0" HeightRequest="26" WidthRequest="40"
                        HorizontalOptions="Center" VerticalOptions="Center">
                    <BoxView CornerRadius="3"
                             Color="{Binding Qualifier2Ranking.IsTop25, Converter={StaticResource BoolToColorConverter}}" />
                    <Label Text="{Binding Qualifier2Ranking.OverallRank}"
                           FontSize="10" FontAttributes="Bold" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                  </Grid>
                  <Label Grid.Column="1"
                         Text="{Binding Qualifier2Ranking.IsFollowed, Converter={StaticResource FollowTeamGlyphConverter}}"
                         TextColor="{Binding Qualifier2Ranking.IsFollowed, Converter={StaticResource FollowTeamColorConverter}}"
                         FontSize="{StaticResource TeamIconSize}"
                         VerticalOptions="Center" HorizontalOptions="Center" />
                  <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
                    <Label Text="{Binding Qualifier2.TeamName}" FontSize="12" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding Qualifier2Ranking.DisplayConferenceTier}"
                           FontSize="9" Opacity="0.6" LineBreakMode="TailTruncation" />
                  </VerticalStackLayout>
                  <Label Grid.Column="3" Text="{Binding Qualifier2Ranking.Record}" FontSize="10" VerticalOptions="Center" />
                  <Label Grid.Column="4" Text="{Binding Qualifier2Ranking.DisplayRank}" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
                  <Label Grid.Column="5" Text="{Binding Qualifier2Ranking.DisplaySOS}" FontSize="10" VerticalOptions="Center" />
                </Grid>

              </VerticalStackLayout>

              <!-- Tiebreaker log -->
              <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                   BackgroundColor="{AppThemeBinding Light=#F5F0FF, Dark=#1A1520}"
                                   Padding="12,4,16,8" Spacing="2"
                                   BindableLayout.ItemsSource="{Binding TiebreakerLog}">
                <BindableLayout.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Label Text="{Binding .}" FontSize="10"
                           TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}" />
                  </DataTemplate>
                </BindableLayout.ItemTemplate>
              </VerticalStackLayout>

              <!-- Contenders -->
              <VerticalStackLayout IsVisible="{Binding IsContendersExpanded}"
                                   BackgroundColor="{AppThemeBinding Light=#F0F5FF, Dark=#151A20}"
                                   Padding="12,4,16,8" Spacing="2"
                                   BindableLayout.ItemsSource="{Binding Contenders}">
                <BindableLayout.ItemTemplate>
                  <DataTemplate x:DataType="models:ChampionshipContender">
                    <Grid ColumnDefinitions="*,120" Padding="0,2">
                      <Label Grid.Column="0" Text="{Binding TeamName}"
                             FontSize="12" VerticalOptions="Center" />
                      <Label Grid.Column="1"
                             FontSize="11" HorizontalOptions="End" VerticalOptions="Center"
                             TextColor="{AppThemeBinding Light=#444444, Dark=#BBBBBB}">
                        <Label.FormattedText>
                          <FormattedString>
                            <Span Text="A: " FontSize="9"
                                  TextColor="{AppThemeBinding Light={StaticResource TextDisabledLight}, Dark={StaticResource TextDisabledDark}}" />
                            <Span Text="{Binding ActualConferenceRecord}" FontSize="11"
                                  TextColor="{AppThemeBinding Light=#444444, Dark=#BBBBBB}" />
                            <Span Text="  P: " FontSize="9"
                                  TextColor="{AppThemeBinding Light={StaticResource TextDisabledLight}, Dark={StaticResource TextDisabledDark}}" />
                            <Span Text="{Binding ConferenceRecord}" />
                          </FormattedString>
                        </Label.FormattedText>
                      </Label>
                    </Grid>
                  </DataTemplate>
                </BindableLayout.ItemTemplate>
              </VerticalStackLayout>

              <BoxView HeightRequest="1" Opacity="0.15"
                       Color="{AppThemeBinding Light=Black, Dark=White}" />

            </VerticalStackLayout>
          </DataTemplate>
        </CollectionView.ItemTemplate>
        <CollectionView.EmptyView>
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
                <Label Text="{Binding EmptyMessage}" FontSize="14" Opacity="0.7"
                    HorizontalOptions="Center" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </CollectionView.EmptyView>
      </CollectionView>

    </RefreshView>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- ROW 2: Status bar                                   -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Grid Grid.Row="2" HeightRequest="24" ColumnDefinitions="*,Auto"
          BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}">
      <Label Grid.Column="0" Text="{Binding StatusMessage}"
             Padding="8,0" FontSize="10" Opacity="0.5"
             VerticalOptions="Center" HorizontalOptions="Start"
             TextColor="{AppThemeBinding Light=#444444, Dark=#AAAAAA}" />
      <Label Grid.Column="1" Text="( ) = projected value"
             Padding="8,0" FontSize="11" FontAttributes="Italic"
             VerticalOptions="Center" HorizontalOptions="End"
             TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}" />
    </Grid>

  </Grid>
</ContentPage>
